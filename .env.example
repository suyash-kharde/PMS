# Copy to .env on the server and fill in every <...> placeholder.
#   cp .env.example .env && nano .env
# Nothing here is a working credential — the real values never travel in the export.

# ---------------------------------------------------------------- Django
DEBUG=0
# generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=<generate-a-long-random-string>
# comma-separated. Do NOT leave * in production.
ALLOWED_HOSTS=<pms.example.com>
CSRF_TRUSTED_ORIGINS=https://<pms.example.com>

# ---------------------------------------------------------------- database
POSTGRES_DB=pms
POSTGRES_USER=pms
POSTGRES_PASSWORD=<choose-a-strong-password>
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------- http
# the proxy terminates TLS; CERT_HOST is the name the self-signed cert is issued for.
# The proxy auto-regenerates the self-signed cert when it expires or stops covering
# CERT_HOST; an operator-installed CA cert in data/certs/ is left untouched.
CERT_HOST=<pms.example.com>
# extra names/IPs the self-signed cert should also cover, comma-separated (optional;
# localhost + 127.0.0.1 are always included). e.g. a second interface IP.
CERT_SAN=
HTTPS_PORT=443
HTTP_PORT=80
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# web push (VAPID key pair is generated on first boot into ./data/secrets)
VAPID_PRIVATE_KEY_PATH=/app/secrets/vapid.json
VAPID_CLAIM_EMAIL=<admin@example.com>

# ---------------------------------------------------------------- bootstrap
# SEED_DEMO=1 loads the full demo dataset; 0 keeps only roles/capabilities/workflows.
SEED_DEMO=0
SEED_CONFIG=1
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=<choose-a-strong-password>
DJANGO_SUPERUSER_EMAIL=<admin@example.com>

# ---------------------------------------------------------------- LLM (BRD writer)
LLM_BASE_URL=<https://your-llm-host/v1>
LLM_API_KEY=<api-key>
LLM_MODEL=RedHatAI/Qwen3.6-35B-A3B-NVFP4
LLM_TIMEOUT=300
LLM_MAX_TOKENS=8000
LLM_CONTEXT_TOKENS=16000
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------- audio services
DENOISE_URL=http://denoise:8100/v1
ASR_URL=http://asr:8200/v1
DENOISE_MODEL=weya-ai/hush
AUDIO_TIMEOUT=900
# blank = let the model guess. On noisy Marathi/Hindi/English code-mix it guessed Indonesian
# on some turns; "mr" keeps Marathi grammar and leaves English words in Latin script.
ASR_LANGUAGE=mr

# speech-to-text: remote OpenAI-compatible endpoint, multi-language
ASR_MODEL=Qwen/Qwen3-ASR-0.6B
ASR_BASE_URL=<https://your-asr-host/v1>
ASR_API_KEY=<api-key>
# remote = never silently substitute mock text; a failed slice fails the entry
ASR_BACKEND=remote

# speaker diarization — the only model that runs locally, in the asr container.
# Weights download once into ./data/models and are reused across rebuilds.
DIAR_MODEL=pyannote/speaker-diarization-3.1
DIARIZER=auto
DIAR_DEVICE=auto
# gated model: accept the conditions on pyannote/speaker-diarization-3.1 AND
# pyannote/segmentation-3.0, then put a read token here (or on the AI models page)
HF_TOKEN=<hf_read_token>
MAX_CHUNK_SECONDS=25

# engine selection: auto | hush | fallback
DENOISE_ENGINE=auto
# device for the hush weights: auto | cuda | cpu. auto uses the GPU when torch sees one
# and falls back to CPU on any CUDA error. Only matters with INSTALL_HUSH=1.
DENOISE_DEVICE=auto

# build args: 1 = install the real model stacks into the service images
#   INSTALL_HUSH=1      -> torch + DeepFilterLib in the denoise image (~1 GB)
#   INSTALL_DIARIZER=1  -> pyannote.audio in the asr image (the only local model)
INSTALL_HUSH=0
INSTALL_DIARIZER=1

# GPU overlay for the asr + denoise services, read by deploy/deploy.sh:
#   GPU=auto (default) -> use the GPU only if a `--gpus all` container can start, else CPU
#   GPU=1              -> force it (deploy fails if the NVIDIA runtime is broken/missing)
#   GPU=0              -> never use it
GPU=auto

# worker loop
WORKER_INTERVAL=5

# ---------------------------------------------------------------- RAG (Ask AI chat)
# generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
# Postgres role for the chat agent's SQL tool. It can only SELECT from the `rag` schema
# of security-barrier views (apps/rag/migrations/0003) -- never the app's real tables --
# and every view is pre-scoped to one project, so the LLM's SQL never states a project
# and could not override it if it tried. Created/kept in sync by that same migration,
# which reads this value at migrate time -- it must be set before first boot.
RAG_READER_PASSWORD=<generate-a-long-random-string>

# Embedding + reranker endpoints for the RAG index. Optional here: leave blank and
# configure them instead on the AI models page after first boot (kind: Embeddings /
# Reranker) -- that path also lets you attach a private CA cert for TLS. Whichever
# provider (env or database) is marked active wins; the database entry takes priority
# when both exist.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B

# ---------------------------------------------------------------- Penpot (design)
# Per-project isolated design workspaces on a self-hosted Penpot instance. When
# enabled, creating a project provisions a dedicated Penpot bot account + its own
# team + a starter file; the project's "Design" tab links straight to it and can
# mint a public no-login view link. Provisioning runs in the background worker.
#
# The Penpot instance must allow registration and (ideally) have
# `disable-email-verification` in PENPOT_FLAGS so bot accounts activate instantly.
PENPOT_ENABLED=0
# pms_web AND pms_worker must resolve the SAME value — after changing this, recreate
# BOTH (`up -d --force-recreate web worker`), not just `restart`.
PENPOT_BASE_URL=http://penpot.example.com:9001
# Domain for generated bot addresses, e.g. penpot+plat@planwise.local
PENPOT_BOT_EMAIL_DOMAIN=planwise.local
PENPOT_VERIFY_SSL=1
PENPOT_TIMEOUT=30
# Optional: emails invited to every project's Penpot team (comma-separated).
PENPOT_DEFAULT_INVITES=
# Public URL of the shared Penpot MCP service (deployed `penpotapp/mcp` in --multi-user /
# remote mode) that Claude Code connects to as the `penpot` server. Blank = the Design tab
# tells developers to ask an admin to publish it. e.g. http://penpot.example.com:4401/mcp
PENPOT_MCP_URL=
